# ─── Informes de cierre ───────────────────────────────────────────
# El PDF se genera en el navegador: no requiere variables aquí. La clave de
# IA (opcional) es un secreto de la Edge Function 'informes-cierre' en
# Supabase, nunca va en este archivo. Ver supabase/functions/README.md

# ─── Dictar reporte (cierre de servicio por voz) ──────────────────
# SOLO EN EL SERVIDOR: configúralas en Vercel → Settings → Environment
# Variables. Para probar en tu PC ponlas en .env.development.local (Git lo
# ignora). NO las pongas en .env.local: ese archivo está en el repositorio.
# TRANSCRIPCION_API_KEY=            # obligatoria (OpenAI, Groq u otro compatible)
# TRANSCRIPCION_URL=https://api.openai.com/v1/audio/transcriptions
# TRANSCRIPCION_MODELO=whisper-1
# TRANSCRIPCION_IDIOMA=es
# ANTHROPIC_API_KEY=                # separa los campos del dictado (sin ella solo transcribe)
# DICTADO_MODELO_IA=claude-opus-5-5
# DICTADO_MAX_SEGUNDOS=180
# DICTADO_MAX_MB=4
# DICTADO_CONSERVAR_AUDIO=false     # true = guarda el audio en el bucket privado dictados-audio
